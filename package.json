  "description": "Study timer for ST0503 BED using Express.js, libsql, and Drizzle ORM",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon --config _extras/nodemon.json index.js",
